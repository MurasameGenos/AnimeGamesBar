<Window
    x:Class="AnimeGamesBar.App.KuroMobileLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="库街区移动端登录"
    mc:Ignorable="d">

    <Grid
        Padding="24"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="库街区短信验证码登录" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="用于获取鸣潮小组件和签到接口需要的 APP Token。" />
        </StackPanel>

        <TextBox
            x:Name="MobileBox"
            Grid.Row="1"
            Header="手机号"
            InputScope="Number"
            MaxLength="11"
            PlaceholderText="请输入库街区绑定手机号" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="CodeBox"
                Grid.Column="0"
                Header="验证码"
                InputScope="Number"
                MaxLength="8"
                PlaceholderText="短信验证码" />

            <Button
                x:Name="SendCodeButton"
                Grid.Column="1"
                MinWidth="112"
                Margin="0,24,0,0"
                Click="SendCodeButton_OnClick"
                Content="发送验证码" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            Spacing="8"
            VerticalAlignment="Bottom">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="如果库街区要求极验风控，本窗口会提示改用网页登录或手动填写 Token。"
                TextWrapping="WrapWholeWords" />
            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="请输入手机号并发送验证码。"
                Severity="Informational" />
        </StackPanel>

        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Click="CancelButton_OnClick"
                Content="取消" />
            <Button
                x:Name="FinishButton"
                Click="FinishButton_OnClick"
                Content="完成登录"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
