<Window
    x:Class="AnimeGamesBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AnimeGames Bar"
    mc:Ignorable="d">

    <Grid
        x:Name="Root"
        Background="#202124"
        RequestedTheme="{Binding RootTheme}">
        <Grid.Resources>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202124" />
            <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#28292B" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#303133" />
            <SolidColorBrush x:Key="SubtleCardBrush" Color="#37383A" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#163447" />
            <SolidColorBrush x:Key="AppBorderBrush" Color="#3E4043" />
            <SolidColorBrush x:Key="AppTextBrush" Color="#F4F6F8" />
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#A8ADB4" />
            <SolidColorBrush x:Key="AppButtonBrush" Color="#37383A" />
            <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#424446" />
            <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="20,0,20,0"
            Background="{StaticResource PanelSurfaceBrush}"
            ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource AppTextBrush}"
                Text="AnimeGames Bar" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="16">
                <Border
                    Width="330"
                    Height="34"
                    Background="{StaticResource AppButtonBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="{Binding GameSelectorThumbColumn}"
                            Margin="1"
                            Background="{StaticResource AppAccentBrush}"
                            CornerRadius="3" />

                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding SelectArknightsCommand}"
                            Foreground="{StaticResource AppTextBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="&#x660E;&#x65E5;&#x65B9;&#x821F;" />
                        </Button>

                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding SelectEndfieldCommand}"
                            Foreground="{StaticResource AppTextBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="&#x7EC8;&#x672B;&#x5730;" />
                        </Button>

                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Command="{Binding SelectWutheringWavesCommand}"
                            Foreground="{StaticResource AppTextBrush}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="&#x9E23;&#x6F6E;" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AppMutedTextBrush}"
                    Text="{Binding AutoRefreshSummary}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppAccentBrush}"
                    Command="{Binding RefreshCommand}"
                    Foreground="#101418">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="&#x5237;&#x65B0;" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppButtonBrush}"
                    Command="{Binding SignInCommand}"
                    Foreground="{StaticResource AppTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Calendar" />
                        <TextBlock Text="{Binding SignInButtonText}" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppButtonBrush}"
                    Command="{Binding SaveCredentialCommand}"
                    Foreground="{StaticResource AppTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="&#x4FDD;&#x5B58;" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppButtonBrush}"
                    Command="{Binding StartLoginCommand}"
                    Foreground="{StaticResource AppTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Contact" />
                        <TextBlock Text="&#x767B;&#x5F55;" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppButtonBrush}"
                    Command="{Binding ClearCredentialCommand}"
                    Foreground="{StaticResource AppTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Delete" />
                        <TextBlock Text="&#x6E05;&#x9664;" />
                    </StackPanel>
                </Button>
                <Button
                    MinHeight="36"
                    Padding="14,6"
                    Background="{StaticResource AppButtonBrush}"
                    Command="{Binding OpenSettingsCommand}"
                    Foreground="{StaticResource AppTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock Text="&#x8BBE;&#x7F6E;" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border
                Grid.ColumnSpan="3"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{StaticResource AppBorderBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="16,14,16,14" ColumnSpacing="16" Visibility="{Binding DashboardVisibility}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource PanelSurfaceBrush}"
                Padding="18"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppTextBrush}"
                            Text="{Binding SelectedGameTitle}" />
                        <TextBlock
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding AccountPanelSubtitle}" />

                        <ComboBox
                            Header="&#x8D26;&#x53F7;"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding PlayerBindings}"
                            PlaceholderText="&#x672A;&#x9009;&#x62E9;"
                            SelectedItem="{Binding SelectedPlayerBinding, Mode=TwoWay}" />

                        <TextBox
                            Header="{Binding CredFieldHeader}"
                            Text="{Binding Cred, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <PasswordBox
                            x:Name="TokenBox"
                            Header="{Binding TokenFieldHeader}"
                            PasswordChanged="TokenBox_OnPasswordChanged" />

                        <PasswordBox
                            x:Name="CookieBox"
                            Header="{Binding CookieFieldHeader}"
                            PasswordChanged="CookieBox_OnPasswordChanged" />

                        <TextBox
                            Header="{Binding UserIdFieldHeader}"
                            Text="{Binding UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Header="{Binding DeviceIdFieldHeader}"
                            Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Border
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource AppTextBrush}"
                                            Text="&#x81EA;&#x52A8;&#x5237;&#x65B0;" />
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource MutedTextStyle}"
                                            Text="{Binding AutoRefreshSummary}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}" />
                                </Grid>
                                <NumberBox
                                    Header="&#x5237;&#x65B0;&#x9891;&#x7387;&#xFF08;&#x5206;&#x949F;&#xFF09;"
                                    LargeChange="5"
                                    Maximum="180"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{Binding AutoRefreshIntervalMinutes, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="{StaticResource PanelSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTextBrush}"
                        Text="{Binding DoctorName}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{StaticResource AppMutedTextBrush}"
                        Text="{Binding AccountBadgeText}" />
                    </StackPanel>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding ArknightsDashboardVisibility}">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x7406;&#x667A;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding SanityText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding SanityMax}" Value="{Binding SanityValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding SanityRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x65E0;&#x4EBA;&#x673A;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding DroneText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding DroneMax}" Value="{Binding DroneValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding DroneRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x8BAD;&#x7EC3;&#x5BA4;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding TrainingOperatorName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6280;&#x80FD;" />
                                    <TextBlock FontSize="20" Foreground="{StaticResource AppTextBrush}" Text="{Binding TrainingSkillText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5269;&#x4F59;" />
                                    <TextBlock FontSize="20" Foreground="{StaticResource AppTextBrush}" Text="{Binding TrainingRemainingText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5B8C;&#x6210;" />
                                    <TextBlock FontSize="20" Foreground="{StaticResource AppTextBrush}" Text="{Binding TrainingCompleteAtText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x8BA2;&#x5355;&#x8FDB;&#x5EA6;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding OrderText}" />
                                    <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding OrderMax}" Value="{Binding OrderValue}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding OrderCompletionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x5236;&#x9020;&#x8FDB;&#x5EA6;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding ManufactureText}" />
                                    <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding ManufactureMax}" Value="{Binding ManufactureValue}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding ManufactureCompletionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x5E72;&#x5458;&#x75B2;&#x52B3;" />
                                    <TextBlock FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding TiredOperatorsText}" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x9700;&#x4F11;&#x606F;" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x6BCF;&#x5468;&#x527F;&#x706D;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding AnnihilationText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding AnnihilationMax}" Value="{Binding AnnihilationValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding AnnihilationRefreshText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x4FDD;&#x5168;&#x6D3E;&#x9A7B;" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6570;&#x636E;&#x589E;&#x8865;&#x4EEA;" />
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding SecurityServiceText}" />
                                        <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding SecurityServiceMax}" Value="{Binding SecurityServiceValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x6570;&#x636E;&#x589E;&#x8865;&#x6761;" />
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" Text="{Binding SecurityServiceStripText}" />
                                        <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding SecurityServiceStripMax}" Value="{Binding SecurityServiceStripValue}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding SecurityServiceRefreshText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding EndfieldDashboardVisibility}">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x7406;&#x667A;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding EndfieldSanityText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding EndfieldSanityMax}" Value="{Binding EndfieldSanityValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding EndfieldSanityRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x6BCF;&#x65E5;&#x6D3B;&#x8DC3;&#x5EA6;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding EndfieldDailyActivityText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding EndfieldDailyActivityMax}" Value="{Binding EndfieldDailyActivityValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Daily Mission" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x6BCF;&#x5468;&#x4E8B;&#x52A1;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding EndfieldWeeklyTasksText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding EndfieldWeeklyTasksMax}" Value="{Binding EndfieldWeeklyTasksValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Weekly Mission" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x901A;&#x884C;&#x8BC1;&#x7B49;&#x7EA7;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding EndfieldPassLevelText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding EndfieldPassLevelMax}" Value="{Binding EndfieldPassLevelValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Battle Pass" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding WutheringWavesDashboardVisibility}">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x7ED3;&#x6676;&#x6CE2;&#x7247;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringWaveplatesText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringWaveplatesMax}" Value="{Binding WutheringWaveplatesValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding WutheringWaveplatesRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x7ED3;&#x6676;&#x5355;&#x8D28;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringCrystalSolventText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringCrystalSolventMax}" Value="{Binding WutheringCrystalSolventValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Crystal Solvent" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x6BCF;&#x65E5;&#x6D3B;&#x8DC3;&#x5EA6;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringDailyActivityText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringDailyActivityMax}" Value="{Binding WutheringDailyActivityValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding WutheringSignInText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x5468;&#x5EA6;&#x6E38;&#x5386;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringWeeklyVoyageText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringWeeklyVoyageMax}" Value="{Binding WutheringWeeklyVoyageValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Weekly Rouge" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x6218;&#x6B4C;&#x91CD;&#x594F;&#x6B21;&#x6570;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringWeeklyBossText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringWeeklyBossMax}" Value="{Binding WutheringWeeklyBossValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Weekly Challenge" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x5148;&#x7EA6;&#x7535;&#x53F0;&#x7B49;&#x7EA7;" />
                                <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding WutheringBattlePassText}" />
                                <ProgressBar Foreground="{StaticResource AppAccentBrush}" Maximum="{Binding WutheringBattlePassMax}" Value="{Binding WutheringBattlePassValue}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Battle Pass" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x9006;&#x5883;&#x6DF1;&#x5854;" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="{Binding WutheringTowerResetText}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5468;&#x671F;&#x91CD;&#x7F6E;" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x51A5;&#x6B4C;&#x6D77;&#x589F;" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="{Binding WutheringSeaResetText}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x5468;&#x671F;&#x91CD;&#x7F6E;" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="{StaticResource CardSurfaceBrush}"
                            Padding="18"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource MetricTitleStyle}" Text="&#x7EC8;&#x7109;&#x77E9;&#x9635;" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" Text="{Binding WutheringFinalBattleEndText}" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="&#x7ED3;&#x675F;&#x65F6;&#x95F4;" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="16,14,16,14"
            Visibility="{Binding SettingsVisibility}">
            <Border
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="22">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="24"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AppTextBrush}"
                                Text="&#x8BBE;&#x7F6E;" />
                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="AnimeGames Bar" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            MinHeight="36"
                            Padding="14,6"
                            Background="{StaticResource AppButtonBrush}"
                            Command="{Binding CloseSettingsCommand}"
                            Foreground="{StaticResource AppTextBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Back" />
                                <TextBlock Text="&#x8FD4;&#x56DE;" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <ToggleSwitch
                                Header="&#x6DF1;&#x8272;&#x6A21;&#x5F0F;"
                                IsOn="{Binding UseDarkTheme, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <ToggleSwitch
                                Header="&#x81EA;&#x52A8;&#x7B7E;&#x5230;"
                                IsOn="{Binding AutoSignEnabled, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <ToggleSwitch
                                Header="Windows &#x901A;&#x77E5;"
                                IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <ToggleSwitch
                                Header="&#x5F00;&#x673A;&#x81EA;&#x542F;"
                                IsOn="{Binding StartWithWindows, Mode=TwoWay}" />
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                            <ToggleSwitch
                                Header="&#x624B;&#x52A8;&#x7B7E;&#x5230;&#x5168;&#x90E8;&#x6E38;&#x620F;"
                                IsOn="{Binding ManualSignInAllGames, Mode=TwoWay}"
                                OffContent="&#x5F53;&#x524D;&#x9875;&#x9762;"
                                OnContent="&#x5168;&#x90E8;&#x6E38;&#x620F;" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsOpen="{Binding HasStatusMessage}"
            IsClosable="False"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}" />
    </Grid>
</Window>
