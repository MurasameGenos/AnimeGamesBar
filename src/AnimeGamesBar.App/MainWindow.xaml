<Window
    x:Class="AnimeGamesBar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AnimeGames Bar"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Command="{Binding RefreshCommand}" Label="&#x5237;&#x65B0;">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Refresh" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{Binding SaveCredentialCommand}" Label="&#x4FDD;&#x5B58;">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Save" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{Binding StartLoginCommand}" Label="&#x767B;&#x5F55;">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Contact" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{Binding ClearCredentialCommand}" Label="&#x6E05;&#x9664;">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Delete" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <Grid Grid.Row="1" Padding="24,12,24,20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="18"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="&#x660E;&#x65E5;&#x65B9;&#x821F;" />

                        <ComboBox
                            Header="&#x8D26;&#x53F7;"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding PlayerBindings}"
                            PlaceholderText="&#x672A;&#x9009;&#x62E9;"
                            SelectedItem="{Binding SelectedPlayerBinding, Mode=TwoWay}" />

                        <TextBox
                            Header="Cred"
                            Text="{Binding Cred, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <PasswordBox
                            x:Name="TokenBox"
                            Header="Token"
                            PasswordChanged="TokenBox_OnPasswordChanged" />

                        <PasswordBox
                            x:Name="CookieBox"
                            Header="Cookie"
                            PasswordChanged="CookieBox_OnPasswordChanged" />

                        <TextBox
                            Header="User ID"
                            Text="{Binding UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBox
                            Header="Device ID"
                            Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ToggleSwitch
                            Header="&#x81EA;&#x52A8;&#x5237;&#x65B0;"
                            IsOn="{Binding AutoRefreshEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding DoctorName}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding AccountBadgeText}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x7406;&#x667A;" />
                                <TextBlock FontSize="34" FontWeight="SemiBold" Text="{Binding SanityText}" />
                                <ProgressBar Maximum="{Binding SanityMax}" Value="{Binding SanityValue}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SanityRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x65E0;&#x4EBA;&#x673A;" />
                                <TextBlock FontSize="34" FontWeight="SemiBold" Text="{Binding DroneText}" />
                                <ProgressBar Maximum="{Binding DroneMax}" Value="{Binding DroneValue}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding DroneRecoveryText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x8BAD;&#x7EC3;&#x5BA4;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding TrainingOperatorName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x6280;&#x80FD;" />
                                    <TextBlock FontSize="20" Text="{Binding TrainingSkillText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x5269;&#x4F59;" />
                                    <TextBlock FontSize="20" Text="{Binding TrainingRemainingText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x5B8C;&#x6210;" />
                                    <TextBlock FontSize="20" Text="{Binding TrainingCompleteAtText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x8BA2;&#x5355;&#x8FDB;&#x5EA6;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding OrderText}" />
                                    <ProgressBar Maximum="{Binding OrderMax}" Value="{Binding OrderValue}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding OrderCompletionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x5236;&#x9020;&#x8FDB;&#x5EA6;" />
                                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="{Binding ManufactureText}" />
                                    <ProgressBar Maximum="{Binding ManufactureMax}" Value="{Binding ManufactureValue}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ManufactureCompletionText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x5E72;&#x5458;&#x75B2;&#x52B3;" />
                                    <TextBlock FontSize="32" FontWeight="SemiBold" Text="{Binding TiredOperatorsText}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x9700;&#x4F11;&#x606F;" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x6BCF;&#x5468;&#x527F;&#x706D;" />
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="{Binding AnnihilationText}" />
                                <ProgressBar Maximum="{Binding AnnihilationMax}" Value="{Binding AnnihilationValue}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding AnnihilationRefreshText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Padding="18"
                            BorderBrush="{ThemeResource PanelStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="&#x4FDD;&#x5168;&#x6D3E;&#x9A7B;" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x6570;&#x636E;&#x589E;&#x8865;&#x4EEA;" />
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SecurityServiceText}" />
                                        <ProgressBar Maximum="{Binding SecurityServiceMax}" Value="{Binding SecurityServiceValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x6570;&#x636E;&#x589E;&#x8865;&#x6761;" />
                                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding SecurityServiceStripText}" />
                                        <ProgressBar Maximum="{Binding SecurityServiceStripMax}" Value="{Binding SecurityServiceStripValue}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SecurityServiceRefreshText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <InfoBar
            Grid.Row="2"
            IsOpen="{Binding HasStatusMessage}"
            IsClosable="False"
            Message="{Binding StatusMessage}"
            Severity="{Binding StatusSeverity}" />
    </Grid>
</Window>
